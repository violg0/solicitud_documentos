rules_version = '2';

// Reglas de negocio impuestas del lado del servidor.
// Campos reales del proyecto (ver lib/models):
//   Usuarios/{uid}      -> nombre, email, rol  (el uid es el id del documento)
//   Solicitudes/{id}    -> idDocumento, idUsuario, periodo,
//                          observacionEstudiante, estado, fechaCreacion,
//                          fechaModificacion, observacionRevision,
//                          fechaEntrega, entregadoPor
//   Motivos/{id}        -> idSolicitud, mensaje, estado, fechaCreacion
//   rol: 'estudiante' | 'revisor' | 'secretaria'
//
// Los roles revisor y secretaria se asignan SOLO a mano desde la consola de
// Firebase: ninguna regla permite que la app los escriba.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data;
    }

    // Un usuario sin documento en Usuarios no tiene rol: ninguna de estas
    // funciones le concede nada.
    function tienePerfil() {
      return exists(/databases/$(database)/documents/Usuarios/$(request.auth.uid));
    }

    function esEstudiante() {
      return autenticado() && tienePerfil() && perfil().rol == 'estudiante';
    }

    function esPrivilegiado() {
      return autenticado() && tienePerfil()
        && (perfil().rol == 'revisor' || perfil().rol == 'secretaria');
    }

    // Máquina de estados que impone el servidor (la misma de SolicitudValidators):
    //   solicitada -> enRevision                 (revisor)
    //   enRevision -> aprobada | rechazada       (revisor)
    //   aprobada   -> entregada                  (secretaria)
    //   solicitada -> cancelada                  (estudiante dueño; ver más abajo)
    // entregada, rechazada y cancelada son estados finales: de ahí no sale
    // ninguna transición, ni siquiera "entregada -> entregada".
    function transicionValida(actual, nuevo, rol) {
      return (actual == 'solicitada' && nuevo == 'enRevision' && rol == 'revisor')
        || (actual == 'enRevision' && (nuevo == 'aprobada' || nuevo == 'rechazada')
            && rol == 'revisor')
        || (actual == 'aprobada' && nuevo == 'entregada' && rol == 'secretaria');
    }

    // Campos que puede escribir cada transición (además se exige que el campo
    // cambiado sea de ese conjunto y nada más):
    //   * aprobada / rechazada -> estado, fechaModificacion y la
    //                             observacionRevision del revisor;
    //   * entregada            -> estado, fechaModificacion, fechaEntrega y
    //                             entregadoPor (datos de la entrega);
    //   * enRevision           -> solo estado y fechaModificacion.
    function camposDeTransicion(nuevo) {
      return nuevo == 'entregada'
        ? ['estado', 'fechaModificacion', 'fechaEntrega', 'entregadoPor']
        : ((nuevo == 'aprobada' || nuevo == 'rechazada')
            ? ['estado', 'fechaModificacion', 'observacionRevision']
            : ['estado', 'fechaModificacion']);
    }

    // Entregar exige dejar registrado quién (el propio uid, no el de otro) y
    // cuándo. La observación de revisión, si viene, debe ser texto.
    function datosDeCambioValidos(nuevo) {
      return (nuevo != 'entregada'
          || (request.resource.data.entregadoPor == request.auth.uid
              && request.resource.data.fechaEntrega is string))
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['observacionRevision'])
            || request.resource.data.observacionRevision is string);
    }

    // ---------- Usuarios ----------
    match /Usuarios/{userId} {
      // El propio perfil; revisor y secretaria pueden leer cualquiera (la app
      // muestra el nombre del solicitante en vez del uid). Solo lectura: la
      // escritura sigue cerrada abajo.
      allow read: if autenticado()
        && (request.auth.uid == userId || esPrivilegiado());

      // Autorregistro: el id del documento es el uid propio y el rol enviado
      // es SIEMPRE 'estudiante'. Sin esto cualquiera podría llamar a la API
      // de Firestore y asignarse revisor/secretaria.
      allow create: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'rol'])
        && request.resource.data.rol == 'estudiante';

      // Sin update/delete desde el cliente: el rol no se puede escalar después.
      allow update, delete: if false;
    }

    // ---------- Documentos (catálogo) ----------
    match /Documentos/{docId} {
      allow read: if autenticado();
      allow write: if false; // se gestionan desde la consola
    }

    // ---------- Solicitudes ----------
    match /Solicitudes/{solicitudId} {
      // El dueño lee las suyas; revisor y secretaria leen todas.
      allow read: if autenticado()
        && (resource.data.idUsuario == request.auth.uid || esPrivilegiado());

      // Un estudiante crea solo a su nombre y siempre en estado inicial,
      // para que no pueda "nacer" ya aprobada.
      allow create: if esEstudiante()
        && request.resource.data.idUsuario == request.auth.uid
        && request.resource.data.estado == 'solicitada'
        && request.resource.data.keys().hasOnly(
             ['idDocumento', 'idUsuario', 'periodo', 'observacionEstudiante',
              'estado', 'fechaCreacion', 'fechaModificacion',
              'observacionRevision', 'fechaEntrega', 'entregadoPor']);

      allow update: if
        // Revisor/secretaria: el cambio de estado debe ser una transición
        // válida para su rol y solo puede tocar los campos de esa transición
        // (ver camposDeTransicion). Así una pantalla desactualizada o un doble
        // toque no puede entregar dos veces ni reabrir una solicitud cerrada.
        (esPrivilegiado()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(camposDeTransicion(request.resource.data.estado))
          && transicionValida(resource.data.estado, request.resource.data.estado,
                              perfil().rol)
          && datosDeCambioValidos(request.resource.data.estado))
        // El dueño solo puede reenviar la solicitud idéntica (la app reintenta
        // el guardado offline con set()). Cualquier otro cambio se rechaza.
        || (esEstudiante()
          && resource.data.idUsuario == request.auth.uid
          && request.resource.data == resource.data)
        // Única excepción de estado para el estudiante: cancelar la suya
        // mientras está 'solicitada'. Solo cambian estado y fechaModificacion
        // (la app actualiza ambos al cambiar de estado); ningún otro campo.
        || (esEstudiante()
          && resource.data.idUsuario == request.auth.uid
          && resource.data.estado == 'solicitada'
          && request.resource.data.estado == 'cancelada'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'fechaModificacion']));

      allow delete: if false;
    }

    // ---------- Motivos ----------
    match /Motivos/{motivoId} {
      // Dueño de la solicitud, revisor o secretaria.
      allow read: if autenticado()
        && (esPrivilegiado()
          || get(/databases/$(database)/documents/Solicitudes/$(resource.data.idSolicitud))
               .data.idUsuario == request.auth.uid);

      allow create: if request.resource.data.keys().hasOnly(
             ['idSolicitud', 'mensaje', 'estado', 'fechaCreacion'])
        && (
          // Revisor o secretaria: en cualquier caso.
          esPrivilegiado()
          // Estudiante: solo el motivo de la cancelación de SU solicitud.
          // getAfter() mira la solicitud tal como queda tras la escritura:
          // sirve tanto si la app cancela primero y crea el motivo después
          // (dos escrituras) como si lo hace en un mismo batch.
          || (esEstudiante()
            && request.resource.data.estado == 'cancelada'
            && getAfter(/databases/$(database)/documents/Solicitudes/$(request.resource.data.idSolicitud))
                 .data.idUsuario == request.auth.uid
            && getAfter(/databases/$(database)/documents/Solicitudes/$(request.resource.data.idSolicitud))
                 .data.estado == 'cancelada')
        );

      allow update, delete: if false;
    }
  }
}
